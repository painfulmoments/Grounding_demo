# Release binaries are published as GitHub Release assets, not Git objects.
*.exe
*.dll
*.pdb
*.pak
*.ucas
*.utoc
*.zip
*.zip.*
*.7z
*.7z.*
*.rar
*.[0-9][0-9][0-9]

# Do not accidentally publish the private Unreal project or build intermediates.
/Source/
/Content/
/Config/
/Plugins/
/Binaries/
/Build/
/Intermediate/
/Saved/
/DerivedDataCache/
/artifacts/
/staging/
/release/
*.uproject
*.sln
*.suo
.vs/

# Local credentials and machine-specific runtime configuration.
.env
.env.*
!.env.example
*.key
*.pem
credentials*
secrets*
*.ini
!*.example.ini
RuntimeSettings.json
UserSettings.json
*.log

# Desktop and editor files.
Thumbs.db
Desktop.ini
.DS_Store
*.tmp
*.bak
__pycache__/
